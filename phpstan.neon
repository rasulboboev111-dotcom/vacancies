includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5

    paths:
        - app

    # Pre-existing findings are captured in phpstan-baseline.neon so CI stays
    # green; new code is held to level 5. Regenerate with:
    #   vendor/bin/phpstan analyse --generate-baseline
