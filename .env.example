APP_NAME="HR Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://your-domain.tj

# UI language is Tajik; English is the fallback.
APP_LOCALE=tg
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────
# PostgreSQL is REQUIRED. Migrations use Postgres-only features (partial
# unique indexes, CHECK constraints, ALTER COLUMN ... TYPE ... USING).
# SQLite/MySQL will fail to migrate.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vacancies
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Tojiktelecom org-structure sync ──────────────────────────────────
# The daily import (`php artisan org:import --api`) pulls
# branches → departments → employees from the v1 API using a static
# bearer token (Authorization: Bearer ...). Leave TOJIKTELECOM_TOKEN empty
# to disable the live sync (you can still import from a JSON dump with
# `php artisan org:import --file=...`).
TOJIKTELECOM_API_URL=https://org.tojiktelecom.tj/api/v1/organization/structure
# WARNING: this is a real secret. Committing .env.example exposes it in git
# history (incl. GitHub). Prefer keeping the token only in .env (git-ignored).
TOJIKTELECOM_TOKEN=1|r09Vhv6i5ZERrHN2ZZfFJ5LaYCnmRwCDY8FAFg3T6a0cbf0e

VITE_APP_NAME="${APP_NAME}"

# --- Application intake from hrbot (must match bot SITE_API_KEY) ---
INTAKE_API_KEY=change-me-to-a-long-random-secret
INTAKE_DISK=local
