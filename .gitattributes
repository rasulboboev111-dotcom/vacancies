* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Dev-only — kept in version control (CI/gates run them) but excluded from
# production release archives (`git archive`). Tests are NOT deleted; prod
# leanness comes from `composer install --no-dev` + not shipping these paths.
/tests export-ignore
phpunit.xml export-ignore
vitest.config.js export-ignore
phpstan.neon export-ignore
phpstan-baseline.neon export-ignore
pint.json export-ignore
eslint.config.js export-ignore
tsconfig.json export-ignore
.editorconfig export-ignore
.gitattributes export-ignore
.gitignore export-ignore
